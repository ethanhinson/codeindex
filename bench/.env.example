# Copy to bench/.env (gitignored) to count tokens with Claude's exact tokenizer.
# Without this, the harness uses tiktoken cl100k_base (ratios are tokenizer-robust;
# absolute counts approximate).

ANTHROPIC_API_KEY=sk-ant-...

# Optional: model whose tokenizer is used for counting (default: claude-sonnet-4-6).
# ANTHROPIC_COUNT_MODEL=claude-sonnet-4-6
