# secrets / local env
.env

# python bench spike
__pycache__/
*.pyc
bench/repos-cache/

# engine build artifacts
/codeindex
.codeindex/

# agent-ab harness: binary + live results (regenerated)
bench/agent_ab/.bin/
bench/agent_ab/results/runs*.jsonl
bench/agent_ab/results/graded*.jsonl
bench/agent_ab/results/transcripts/
.superpowers/

# Local agent worktrees (nested repos) — never track
.claude/worktrees/

# frontend
web/node_modules/
web/test-results/
web/playwright-report/
web/.vite/

# docket:start (managed by docket — do not hand-edit)
.docket/
.worktrees/
.claude/settings.local.json
.docket.local.yml
.claude/agents/docket-*.md
.codex/agents/docket-*.md
.cursor/agents/docket-*.md
.agents/agents/docket-*.md
.kiro/agents/docket-*.md
.windsurf/agents/docket-*.md
.codex/agents/docket-*.toml
.cursor/rules/docket-dispatch.mdc
# docket:end
bench/agent_ab/.arm_a_shim/
bench/scout/*.jsonl
bench/scout/judge_sample*.json
bench/scout/__pycache__/
bench/scout/.venv/

# vendored llama.cpp (regenerate: scripts/vendor-llama.sh)
/third_party/

# bench working clones (pinned via bench/repos.json; re-clone to regenerate)
bench/repos/*
# …except the authored workspace manifest (not a clone; cannot be re-cloned).
# Each level must be re-included then re-excluded: git will not descend into an
# ignored directory, so a bare `bench/repos/` rule makes the negations below
# unreachable. Nothing but workspace.json itself is committable.
!bench/repos/oss-ws/
bench/repos/oss-ws/*
!bench/repos/oss-ws/.codeindex/
bench/repos/oss-ws/.codeindex/*
!bench/repos/oss-ws/.codeindex/workspace.json
# per-experiment agent transcripts (bulky; runs.jsonl is the durable record)
bench/agent_ab/v8_search/results/transcripts/
bench/agent_ab/v9_btt/results/transcripts/
bench/agent_ab/results/transcripts_noteab/

# OS / editor junk
.DS_Store
*.bak

# bench transcripts capture whatever the agent sees (env paths, dir listings) — never commit
bench/workspace/results/transcripts/
bench/workspace/results/tainted_armA/ws-*.jsonl
bench/workspace/results/tainted_armA_2/
bench/workspace/results/tainted_armA_3/
bench/workspace/results_frontier_*/transcripts/
bench/workspace/results/fuse_traces_ws/
# fuse agent homes: tool-output mirrors transcripts; config.yml embeds absolute $HOME paths
bench/workspace/.fusehomes/
# live run rows (regenerated); grades.jsonl is the curated archive and stays tracked
bench/workspace/results/runs_fuse.jsonl
# qwen fuse run logs; the arm*_haiku.log campaign records are tracked on purpose
bench/workspace/results/fullA_qwen.log
bench/workspace/results/fullB_qwen.log
bench/workspace/results/smokeA.log
bench/workspace/results/smokeB.log
